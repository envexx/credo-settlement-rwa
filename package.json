{
  "name": "settlerwa",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint --max-warnings=0 src worker db contracts/script",
    "format:check": "prettier --check src worker db contracts/script *.json *.ts",
    "start": "next start",
    "test": "tsx src/lib/store.test.ts && tsx src/lib/live-demo.test.ts && tsx src/lib/demo-lock.test.ts && tsx src/lib/rpc.test.ts && tsx worker/core.test.ts && tsx worker/drain.test.ts && tsx src/app/infra/page.test.ts && tsx src/lib/settlement-presentation.test.ts && tsx src/app/product-copy.test.ts && tsx src/app/api/v1/playground/live-sale/route.test.ts",
    "worker": "tsx --env-file=.env.local worker/service.ts",
    "worker:once": "tsx --env-file=.env.local worker/live.ts",
    "db:migrate": "tsx db/migrate.ts",
    "contracts:deploy": "tsx --env-file=.env.local contracts/script/deploy.ts",
    "preflight": "tsx --env-file=.env.local scripts/preflight.ts",
    "contracts:verify": "tsx --env-file=.env.local scripts/verify-deployment.ts",
    "demo:setup-live": "tsx --env-file=.env.local scripts/setup-live-demo.ts",
    "demo:verify-live": "tsx --env-file=.env.local scripts/verify-live-settlement.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gluwa/usc-contracts": "^0.1.2",
    "@gluwa/usc-sdk": "^0.18.0",
    "@openzeppelin/contracts": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  }
}
